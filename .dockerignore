# Ignore everything by default
**

# Include only what's needed for the Railway build
!Dockerfile
!railway-entrypoint.sh
!railway.json

# Server source compiled by the builder stage (2FA login, session tokens)
!package.json
!package-lock.json
!tsconfig.json
!src/**
!typings/**

# Voice Control extension (built into a VSIX by the voice-builder stage)
!extensions/voice-control/**
extensions/voice-control/node_modules
extensions/voice-control/dist
extensions/voice-control/*.vsix

# Build-time webview patch
!scripts/patch-webview-microphone.py

# Built-in speech-to-text worker
!stt/**
!scripts/ensure-vscode-settings.cjs
!scripts/watch-inotify.sh
